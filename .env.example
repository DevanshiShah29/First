# Public site origin (no trailing slash). Used for sitemap.xml, robots.txt, and metadata.
# Example: https://your-domain.com
# SITE_URL=

# Optional Google Analytics 4 measurement id (public — NEXT_PUBLIC_* is intentional).
# Create a GA4 property at https://analytics.google.com → Admin → Data streams → Web,
# then paste the Measurement ID (G-XXXXXXXX). Leave blank to disable GA.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Bootstrap CMS login password (server-only — never NEXT_PUBLIC_*).
# After you change the password from CMS → Settings, the database hash
# takes precedence and this value is ignored for login.
ADMIN_PASSWORD=change-this

# Required signing key for cms_session cookies (and default content encryption).
# Use a long random string, different from ADMIN_PASSWORD.
# Production refuses to fall back to ADMIN_PASSWORD.
CMS_SECRET=

# Optional dedicated key for encrypting sensitive CMS fields at rest (e.g. piano YouTube URL).
# Defaults to CMS_SECRET when unset. Keep server-side only.
# CONTENT_ENCRYPTION_KEY=

# Neon Postgres (Prisma)
# Pooled connection for the app (hostname includes -pooler)
DATABASE_URL="STRING"
# Direct connection for migrations (no -pooler in hostname)
DIRECT_URL="STRING"

# Contact form — configure at least one delivery path (server-only).
# Prefer Resend when available; otherwise FormSubmit via FORMSUBMIT_KEY.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# FormSubmit form id from the activation email. No hardcoded fallback in source.
FORMSUBMIT_KEY=

# Gemini — CMS "Generate with AI" (Experience, Projects, Skills, Technologies).
# Keep server-side only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel Blob — durable CMS uploads (hero, skills, memories, resume).
# Required in production. Without it, uploads write to public/uploads (local/dev only).
# Create a store in the Vercel dashboard → Storage → Blob, then copy the token.
# BLOB_READ_WRITE_TOKEN=

# Upstash Redis — shared rate limits for login, forgot-password, and contact.
# Required for durable limits across serverless instances. Without it, limits are
# in-memory only (fine for local; weak in production multi-instance).
# Create a database at https://upstash.com (or Vercel → Storage → Upstash).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Raises GitHub API rate limits when generating project copy.
# GITHUB_TOKEN=

# Piano music YouTube URL is stored encrypted in the database via the CMS
# (Site / Hero screens). It is never committed to source and is never sent
# to public client props — playback goes through GET /api/media/piano.
