generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: non-pooled connection for migrations / db push
  directUrl = env("DIRECT_URL")
}

/// Singleton CMS auth override (id = "main"). When passwordHash is set,
/// it takes precedence over ADMIN_PASSWORD for login.
model CmsAuth {
  id                  String    @id @default("main")
  passwordHash        String?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  /// Bumped on password change/reset so existing cms_session cookies fail verify.
  sessionVersion      Int       @default(0)
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())
}

/// Core site identity, copy, and contact/social links (singleton id = "main").
model SiteSettings {
  id String @id @default("main")

  name             String
  initials         String
  title            String
  description      String
  pianoYoutubeUrl  String   @default("")
  goodreadsUrl     String   @default("")
  kicker           String   @default("")
  greeting         String   @default("")
  roles            String[]
  line             String   @default("")
  about            String   @default("")
  philosophyKicker String   @default("")
  philosophyTitle  String   @default("")
  philosophy       String   @default("")
  experienceIntro  String   @default("")
  contactLine      String   @default("")
  email            String   @default("")
  linkedin         String   @default("")
  github           String   @default("")
  resume           String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stats SiteStat[]
  hero  HeroSettings?
  theme ThemeSettings?
}

/// Hero template + media (1:1 with SiteSettings).
model HeroSettings {
  siteId     String @id @default("main")
  template   String
  mediaKind  String
  mediaUrl   String @default("")
  mediaPlace String
  mediaSide  String

  site SiteSettings @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

/// Theme tokens (1:1 with SiteSettings). Palettes stored as JSON.
model ThemeSettings {
  siteId      String  @id @default("main")
  defaultMode String
  allowToggle Boolean
  brandFrom   String
  brandTo     String
  /// ThemePalette JSON: background, foreground, card, …
  dark        Json
  /// ThemePalette JSON
  light       Json

  site SiteSettings @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteStat {
  id        String @id @default(cuid())
  siteId    String @default("main")
  sortOrder Int
  value     Int
  suffix    String @default("")
  label     String

  site SiteSettings @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, sortOrder])
}

model Experience {
  id        String   @id
  sortOrder Int
  when      String   @default("")
  current   Boolean  @default(false)
  role      String
  company   String   @default("")
  summary   String   @default("")
  bullets   String[]
  stack     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Project {
  id        String   @id
  sortOrder Int
  name      String
  blurb     String   @default("")
  tags      String[]
  github    String   @default("")
  demo      String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Memory {
  id        String  @id
  sortOrder Int
  title     String  @default("")
  note      String  @default("")
  date      String  @default("")
  category  String  @default("")
  icon      String  @default("")
  photoUrl  String  @default("")
  color     String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// kind: "skills" | "technologies"
model SkillGroup {
  id        String @id @default(cuid())
  kind      String
  title     String
  sortOrder Int

  items SkillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, sortOrder])
}

model SkillItem {
  id        String  @id @default(cuid())
  groupId   String
  sortOrder Int
  name      String
  icon      String  @default("empty")
  color     String?
  iconUrl   String?

  group SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

/// Public /craft page copy (singleton id = "main").
model CraftSettings {
  id       String @id @default("main")
  kicker   String @default("")
  title    String @default("")
  intro    String @default("")
  footnote String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups CraftGroup[]
}

model CraftGroup {
  id        String @id @default(cuid())
  craftId   String @default("main")
  sortOrder Int
  title     String
  intro     String @default("")

  craft CraftSettings @relation(fields: [craftId], references: [id], onDelete: Cascade)
  items CraftItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([craftId, sortOrder])
}

model CraftItem {
  id        String @id @default(cuid())
  groupId   String
  sortOrder Int
  title     String
  why       String @default("")

  group CraftGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

/// Anonymous site visitor (cookie-bound id). No accounts on the public site.
model AnalyticsVisitor {
  id          String   @id @default(cuid())
  /// HMAC of client IP — used only for rate/spam heuristics, never raw IP.
  ipHash      String   @default("")
  /// Truncated User-Agent for device hints in the CMS.
  userAgent   String   @default("")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  pageViews AnalyticsPageView[]

  @@index([lastSeenAt])
}

/// One recorded public page view.
model AnalyticsPageView {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  referrer  String   @default("")
  createdAt DateTime @default(now())

  visitor AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
}
